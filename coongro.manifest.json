            {
              "key": "indices.fx.source",
              "type": "enum",
              "label": "Cotización del dólar",
              "description": "«Automática» busca la cotización del día cuando hay que emitir un cargo de un contrato en dólares, y la guarda. «A mano» la desactiva: se usa únicamente lo que esté cargado en Índices, y un cargo sin la cotización del día no se emite en vez de usar una vieja. Elegila a mano si trabajás sin internet o si pactaste con los propietarios un dólar que no es el que publica el mercado.",
              "default": "dolarapi",
              "options": [
                { "value": "dolarapi", "label": "Buscarla automáticamente" },
                { "value": "manual", "label": "Cargarla a mano" }
              ]
            }
          ]
