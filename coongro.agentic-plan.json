  "version": 1,
  "pluginId": "indices",
  "overrides": {
    "q:indices.fx.convert": {
      "type": "agentic.query",
      "fields": {
        "crossScope": {
          "note": "No escribe ninguna tabla: es una cuenta sobre la cotización que devuelve «Cotización del dólar». Lo único que puede persistirse es esa cotización, y lo hace la otra operación. El prefijo `indices.fx` no tiene entidad propia; las cotizaciones viven en la tabla de valores de índice.",
          "rule": "none"
        }
      },
      "prov": {
        "crossScope": "user"
      }
    },
    "q:indices.fx.houses": {
      "type": "agentic.query",
      "fields": {
        "crossScope": {
          "note": "No toca la base: devuelve la lista de casas de cambio admitidas, que es una constante del código. No hay tabla contra la cual cruzarla porque no hay nada persistido que verificar.",
          "rule": "none"
        }
      },
      "prov": {
        "crossScope": "user"
      }
    },
    "q:indices.fx.rate": {
      "type": "agentic.query",
      "fields": {
        "crossScope": {
          "note": "El prefijo `indices.fx` no tiene tabla propia: las cotizaciones se guardan en la misma tabla de valores de índice que el resto (`module_indices_index_values`), con el código `USD_<casa>`. Por eso el cruce no encuentra `module_indices_fx` — no falta un schema, no existe esa entidad. Lo que la operación escribe es la copia local de un dato público: si la cotización del día no está guardada, la trae de la fuente y la persiste para no volver a salir a internet por lo mismo. Es idempotente por (código, fecha) y deja anotada la fuente.",
          "rule": "none"
        }
      },
      "prov": {
        "crossScope": "user"
      }
    }
  },
